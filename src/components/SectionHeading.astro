---
interface Props {
	title: string;
	subtitle?: string;
	light?: boolean;
	align?: 'center' | 'left';
}

const {
	title,
	subtitle,
	light = false,
	align = 'center',
} = Astro.props;
---

<div
	class:list={[
		'flex flex-col gap-4',
		align === 'center' ? 'items-center text-center' : 'items-start text-left',
	]}
>
	<h2
		class:list={[
			'text-[34px] sm:text-[44px] lg:text-[54px] font-bold leading-[1.2]',
			light ? 'text-white' : 'text-coffee-primary',
		]}
	>
		{title}
	</h2>
	{
		subtitle && (
			<p
				class:list={[
					'text-[17px] sm:text-[20px] font-normal leading-[1.7] max-w-[680px]',
					light ? 'text-white/90' : 'text-coffee-muted',
				]}
			>
				{subtitle}
			</p>
		)
	}
</div>
