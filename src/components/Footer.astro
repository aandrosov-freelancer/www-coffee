---
const aboutLinks = [
	{ label: 'Меню', href: '#menu' },
	{ label: 'Преимущества', href: '#features' },
	{ label: 'Новости и блог', href: '#newsletter' },
	{ label: 'Помощь и поддержка', href: '#footer' },
];

const companyLinks = [
	{ label: 'Как мы работаем', href: '#discover' },
	{ label: 'Условия обслуживания', href: '#footer' },
	{ label: 'Цены и оплата', href: '#menu' },
	{ label: 'Частые вопросы (FAQ)', href: '#testimonials' },
];
---

<footer
	id="footer"
	class="relative w-full bg-coffee-dark text-white pt-32 lg:pt-40 pb-10 overflow-hidden"
>
	<!-- Background Image Overlay with Dark Coffee Gradient -->
	<div
		class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-30 pointer-events-none"
		style="background-image: url('/images/footer-bg.png');"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute inset-0 pointer-events-none"
		style="background: linear-gradient(180deg, #442808 0%, rgba(68, 40, 8, 0.85) 100%);"
		aria-hidden="true"
	>
	</div>

	<div class="relative z-10 max-w-[1180px] mx-auto px-5 sm:px-8">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
			<!-- Column 1: Brand & Description -->
			<div class="lg:col-span-4 flex flex-col items-start gap-5">
				<a
					href="#hero"
					class="font-brand text-[54px] leading-none text-white hover:text-coffee-accent transition-colors"
				>
					Bean Scene
				</a>
				<p class="text-[14px] leading-[1.65] text-white/85 max-w-[380px]">
					Bean Scene — это авторская кофейня, где любовь к отборному зерну сочетается с тёплой
					атмосферой. Мы обжариваем зерно небольшими партиями и бережно завариваем каждую чашку,
					чтобы дарить вам вкус и вдохновение с самого утра.
				</p>

				<!-- Social Links -->
				<div class="flex items-center gap-5 mt-1">
					<a
						href="#footer"
						aria-label="Сообщество ВКонтакте (демо)"
						class="w-9 h-9 rounded-full bg-white/10 hover:bg-coffee-accent hover:text-coffee-darker flex items-center justify-center transition-colors"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M15.07 2H8.93C3.33 2 2 3.33 2 8.93v6.14C2 20.67 3.33 22 8.93 22h6.14c5.6 0 6.93-1.33 6.93-6.93V8.93C22 3.33 20.67 2 15.07 2zm3.08 14.27h-1.46c-.55 0-.72-.44-1.71-1.44-.86-.83-1.24-.94-1.46-.94-.3 0-.38.08-.38.49v1.31c0 .35-.11.56-1.04.56-1.54 0-3.24-.93-4.44-2.67-1.8-2.53-2.29-4.43-2.29-4.82 0-.21.08-.41.49-.41h1.46c.37 0 .51.17.65.56.72 2.08 1.92 3.9 2.41 3.9.19 0 .27-.08.27-.55v-2.14c-.06-.98-.58-1.06-.58-1.41 0-.17.14-.34.37-.34h2.29c.31 0 .42.17.42.53v2.89c0 .31.14.42.23.42.19 0 .34-.11.68-.45 1.05-1.18 1.8-3 1.8-3 .1-.21.27-.41.64-.41h1.46c.44 0 .54.23.44.53-.18.85-1.96 3.36-1.96 3.36-.16.25-.22.37 0 .65.16.21.69.67 1.04 1.08.65.73 1.14 1.34 1.28 1.77.14.42-.08.64-.51.64z"
							></path>
						</svg>
					</a>
					<a
						href="#footer"
						aria-label="Канал в Telegram (демо)"
						class="w-9 h-9 rounded-full bg-white/10 hover:bg-coffee-accent hover:text-coffee-darker flex items-center justify-center transition-colors"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
							></path>
						</svg>
					</a>
					<a
						href="#footer"
						aria-label="Канал на YouTube (демо)"
						class="w-9 h-9 rounded-full bg-white/10 hover:bg-coffee-accent hover:text-coffee-darker flex items-center justify-center transition-colors"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
							></path>
						</svg>
					</a>
				</div>
			</div>

			<!-- Column 2: О нас -->
			<div class="lg:col-span-2 flex flex-col gap-6">
				<h3 class="text-[24px] lg:text-[26px] font-bold text-white leading-tight">О нас</h3>
				<ul class="flex flex-col gap-3.5">
					{
						aboutLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-[17px] text-white/85 hover:text-coffee-accent transition-colors"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Column 3: Компания -->
			<div class="lg:col-span-3 flex flex-col gap-6">
				<h3 class="text-[24px] lg:text-[26px] font-bold text-white leading-tight">Компания</h3>
				<ul class="flex flex-col gap-3.5">
					{
						companyLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-[17px] text-white/85 hover:text-coffee-accent transition-colors"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Column 4: Контакты -->
			<div class="lg:col-span-3 flex flex-col gap-6">
				<h3 class="text-[24px] lg:text-[26px] font-bold text-white leading-tight">Контакты</h3>
				<ul class="flex flex-col gap-3.5 text-[17px] text-white/85">
					<li class="leading-relaxed">
						г. Москва, ул. Большая Садовая, д. 14, стр. 2 (павильон у сквера)
					</li>
					<li>
						<a href="tel:+74950002132" class="hover:text-coffee-accent transition-colors">
							+7 (495) 000-21-32
						</a>
					</li>
					<li>
						<a href="mailto:privet@beanscene.ru" class="hover:text-coffee-accent transition-colors">
							privet@beanscene.ru
						</a>
					</li>
					<li>
						<a href="#hero" class="hover:text-coffee-accent transition-colors">
							www.beanscene.ru
						</a>
					</li>
				</ul>
			</div>
		</div>

		<!-- Disclaimer Bar (Explicitly Requested by User) -->
		<div class="mt-14 pt-7 border-t border-white/15 flex flex-col items-center text-center gap-2">
			<p class="text-[14px] sm:text-[15px] text-coffee-cream/90 max-w-[820px] leading-relaxed">
				Внимание: данный сайт сделан исключительно в демонстрационных целях. Все персонажи, имена,
				отзывы, контактные данные, цены и события вымышлены — любые совпадения с реальными людьми или
				организациями случайны.
			</p>
			<p class="text-[13px] sm:text-[14px] text-white/75">
				Автор оригинального дизайн-макета:
				<a
					href="https://www.figma.com/@thisuix571"
					target="_blank"
					rel="noopener noreferrer"
					class="text-coffee-accent hover:underline font-medium"
				>
					Mohammed Jawed (@thisuix571)
				</a>
				—
				<a
					href="https://www.figma.com/community/file/1201418433329014860/bean-scene-coffee-landingpage?q_id=b570e737-51ab-47ad-a807-dd879fb9f576"
					target="_blank"
					rel="noopener noreferrer"
					class="text-coffee-accent hover:underline font-medium"
				>
					Bean Scene Coffee Landingpage в Figma Community
				</a>
			</p>
			<p class="text-[13px] text-white/55">
				© {new Date().getFullYear()} Bean Scene (Демо-макет). Свёрстано на Astro и Tailwind CSS.
			</p>
		</div>
	</div>
</footer>
