---
---

<section
	class="relative w-full min-h-[540px] lg:min-h-[574px] flex items-center bg-coffee-primary bg-cover bg-center bg-no-repeat overflow-hidden py-16"
	style="background-image: url('/images/promo-bg.png');"
>
	<!-- Warm Brown Tint Overlay -->
	<div class="absolute inset-0 bg-coffee-primary/80 pointer-events-none" aria-hidden="true"></div>

	<!-- Decorative Coffee Beans Corner Image on Right -->
	<img
		src="/images/coffee-bean-overlay.png"
		alt=""
		aria-hidden="true"
		loading="lazy"
		class="pointer-events-none select-none absolute bottom-0 right-0 h-full w-auto object-contain object-bottom-right opacity-90 hidden sm:block"
	/>

	<div class="relative z-10 max-w-[1180px] mx-auto w-full px-5 sm:px-8">
		<div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
			<!-- Left Text Column -->
			<div class="md:col-span-7 flex flex-col items-start gap-6">
				<h2
					class="text-[34px] sm:text-[44px] lg:text-[54px] font-bold text-white leading-[1.2] max-w-[580px]"
				>
					Подарите себе удивительное утро
				</h2>
				<p class="text-[17px] sm:text-[20px] text-white/90 leading-[1.7] max-w-[460px]">
					Мы дарим вам уникальную возможность почувствовать, какой яркой и вдохновляющей может быть
					жизнь с чашкой настоящего кофе.
				</p>
				<button
					type="button"
					data-modal-open="order"
					class="bg-coffee-accent hover:bg-coffee-accent-hover text-coffee-darker text-[16px] font-bold px-7 py-3.5 rounded-[24px] shadow-btn transition-all cursor-pointer active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
				>
					Заказать сейчас
				</button>
			</div>

			<!-- Right Cup Illustration -->
			<div class="md:col-span-5 flex justify-center md:justify-end">
				<img
					src="/images/promo-cup.png"
					alt="Фирменный кофейный стакан Bean Scene на фоне обжаренных зёрен"
					width="300"
					height="467"
					loading="lazy"
					class="w-[220px] sm:w-[270px] lg:w-[300px] h-auto object-contain drop-shadow-2xl"
				/>
			</div>
		</div>
	</div>
</section>
