---
---

<dialog
	id="demo-modal"
	aria-labelledby="demo-modal-title"
	class="backdrop:bg-black/65 backdrop:backdrop-blur-xs bg-transparent p-4 m-auto max-w-[460px] w-full open:flex items-center justify-center"
>
	<div
		class="relative w-full bg-coffee-cream border-2 border-coffee-accent rounded-[20px] p-6 sm:p-8 shadow-2xl text-coffee-darker"
	>
		<!-- Close Button -->
		<button
			type="button"
			id="demo-modal-close"
			aria-label="Закрыть окно"
			class="absolute top-4 right-4 w-9 h-9 rounded-full bg-coffee-primary/10 hover:bg-coffee-primary/20 text-coffee-primary flex items-center justify-center transition-colors cursor-pointer"
		>
			<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>

		<div class="inline-block px-3 py-1 rounded-full bg-coffee-accent/35 text-coffee-primary text-[12px] font-bold uppercase tracking-wider mb-3">
			Демонстрационный режим
		</div>

		<h3 id="demo-modal-title" class="text-[28px] font-bold text-coffee-primary leading-tight mb-2">
			Быстрый заказ кофе
		</h3>
		<p id="demo-modal-subtitle" class="text-[15px] text-coffee-muted leading-relaxed mb-5">
			Оставьте свои данные, и бариста подготовит ваш напиток к вашему приходу.
		</p>

		<form id="demo-modal-form" class="flex flex-col gap-4">
			<div id="demo-modal-drink-group" class="flex flex-col gap-1.5">
				<label for="demo-drink-select" class="text-[14px] font-bold text-coffee-primary">
					Выберите напиток
				</label>
				<select
					id="demo-drink-select"
					name="drink"
					class="w-full px-4 py-2.5 rounded-lg border border-coffee-accent bg-white text-coffee-darker text-[15px] focus:outline-2 focus:outline-coffee-primary"
				>
					<option value="Капучино (390 ₽)">Капучино — 390 ₽</option>
					<option value="Чай Латте (420 ₽)">Чай Латте — 420 ₽</option>
					<option value="Макиато (380 ₽)">Макиато — 380 ₽</option>
					<option value="Эспрессо (290 ₽)">Эспрессо — 290 ₽</option>
				</select>
			</div>

			<div class="flex flex-col gap-1.5">
				<label for="demo-user-name" class="text-[14px] font-bold text-coffee-primary">
					Ваше имя
				</label>
				<input
					id="demo-user-name"
					name="name"
					type="text"
					required
					placeholder="Например, Иван"
					class="w-full px-4 py-2.5 rounded-lg border border-coffee-accent bg-white text-coffee-darker text-[15px] focus:outline-2 focus:outline-coffee-primary"
				/>
			</div>

			<div class="flex flex-col gap-1.5">
				<label for="demo-user-contact" class="text-[14px] font-bold text-coffee-primary">
					Телефон или E-mail
				</label>
				<input
					id="demo-user-contact"
					name="contact"
					type="text"
					required
					placeholder="+7 (999) 000-00-00"
					class="w-full px-4 py-2.5 rounded-lg border border-coffee-accent bg-white text-coffee-darker text-[15px] focus:outline-2 focus:outline-coffee-primary"
				/>
			</div>

			<button
				type="submit"
				id="demo-modal-submit"
				class="mt-2 w-full bg-coffee-accent hover:bg-coffee-accent-hover text-coffee-darker text-[16px] font-bold py-3 rounded-full shadow-btn transition-all cursor-pointer active:scale-95"
			>
				Подтвердить
			</button>
		</form>

		<div
			id="demo-modal-success"
			class="hidden mt-4 p-4 rounded-xl bg-coffee-cream-hover border border-coffee-accent text-center"
		>
			<p class="text-[16px] font-bold text-coffee-primary mb-1">Готово!</p>
			<p id="demo-modal-success-text" class="text-[14px] text-coffee-muted leading-relaxed">
				Заявка успешно принята в демо-режиме.
			</p>
		</div>

		<p class="mt-4 text-[12px] text-coffee-muted/80 text-center">
			Сайт создан в демонстрационных целях. Все персонажи, цены и события вымышлены.
		</p>
	</div>
</dialog>

<script>
	const dialog = document.getElementById('demo-modal') as HTMLDialogElement | null;
	const closeBtn = document.getElementById('demo-modal-close');
	const titleEl = document.getElementById('demo-modal-title');
	const subtitleEl = document.getElementById('demo-modal-subtitle');
	const drinkGroup = document.getElementById('demo-modal-drink-group');
	const drinkSelect = document.getElementById('demo-drink-select') as HTMLSelectElement | null;
	const submitBtn = document.getElementById('demo-modal-submit');
	const form = document.getElementById('demo-modal-form') as HTMLFormElement | null;
	const successBox = document.getElementById('demo-modal-success');
	const successText = document.getElementById('demo-modal-success-text');

	function openModal(mode: string, drinkName?: string) {
		if (!dialog || !titleEl || !subtitleEl || !drinkGroup || !submitBtn || !form || !successBox)
			return;

		form.reset();
		form.classList.remove('hidden');
		successBox.classList.add('hidden');

		if (mode === 'login') {
			titleEl.textContent = 'Вход в клуб гостей';
			subtitleEl.textContent =
				'Войдите в личный кабинет Bean Scene, чтобы копить кофейные зёрна и получать бонусы.';
			drinkGroup.classList.add('hidden');
			submitBtn.textContent = 'Войти';
		} else if (mode === 'signup' || mode === 'join') {
			titleEl.textContent = 'Присоединиться к Bean Scene';
			subtitleEl.textContent =
				'Зарегистрируйтесь в нашей программе лояльности и получите скидку 20% на первую чашку кофе!';
			drinkGroup.classList.add('hidden');
			submitBtn.textContent = 'Зарегистрироваться';
		} else {
			titleEl.textContent = 'Быстрый заказ кофе';
			subtitleEl.textContent =
				'Выберите любимый напиток, и мы приготовим его из свежеобжаренных зёрен к вашему приходу.';
			drinkGroup.classList.remove('hidden');
			submitBtn.textContent = 'Оформить демо-заказ';

			if (drinkName && drinkSelect) {
				const match = Array.from(drinkSelect.options).find((opt) =>
					opt.value.startsWith(drinkName)
				);
				if (match) drinkSelect.value = match.value;
			}
		}

		dialog.showModal();
	}

	document.querySelectorAll<HTMLElement>('[data-modal-open]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const mode = btn.getAttribute('data-modal-open') || 'order';
			openModal(mode);
		});
	});

	document.querySelectorAll<HTMLElement>('[data-order-item]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const drink = btn.getAttribute('data-order-item') || 'Капучино';
			openModal('order', drink);
		});
	});

	closeBtn?.addEventListener('click', () => dialog?.close());

	dialog?.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (!form || !successBox || !successText) return;
		const data = new FormData(form);
		const name = String(data.get('name') || 'Гость');
		form.classList.add('hidden');
		successBox.classList.remove('hidden');
		successText.textContent = `Спасибо, ${name}! Это демонстрационный сайт, поэтому реальная отправка данных не производится.`;
	});
</script>
